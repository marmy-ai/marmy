#!/bin/bash
# Post-install script for MacMarmy.pkg

# Check for tmux (required dependency)
if ! command -v tmux >/dev/null 2>&1; then
    echo "WARNING: tmux is not installed. MacMarmy requires tmux to manage sessions."
    echo ""
    echo "Install tmux with one of:"
    echo "  brew install tmux"
    echo "  sudo port install tmux"
    echo ""
fi

# Open MacMarmy after install. Installer scripts usually run as root, so use
# the active console user instead of $USER.
if [ -d "/Applications/MacMarmy.app" ]; then
    CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
        sudo -u "$CONSOLE_USER" open "/Applications/MacMarmy.app" 2>/dev/null || true
    else
        open "/Applications/MacMarmy.app" 2>/dev/null || true
    fi
fi

exit 0
